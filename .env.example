# Server-only URL accepting inquiry JSON. Must use HTTPS and store durably before returning 2xx.
INQUIRY_WEBHOOK_URL=
# Optional server-only bearer token accepted by your receiver.
INQUIRY_WEBHOOK_TOKEN=
# Set to true only after intake testing and required business/legal approvals.
SHP_PUBLIC_LAUNCH=false
# Email delivery to seacoasthomepartners@gmail.com when no webhook is configured.
RESEND_API_KEY=
# Suggested sender on a domain you must verify with Resend; not an existing mailbox.
INQUIRY_FROM_EMAIL=inquiries@notifications.seacoasthomepartners.com
